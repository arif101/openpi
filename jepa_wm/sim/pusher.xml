<mujoco model="pusher2d">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="64" offheight="64"/>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.4 0.4 0.4"/>
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.12 0.12 0.14" rgb2="0.20 0.20 0.24" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" diffuse="1 1 1"/>
    <camera name="topdown" pos="0 0 1.1" xyaxes="1 0 0 0 1 0"/>
    <geom name="floor" type="plane" size="0.4 0.4 0.01" material="grid"/>
    <geom name="wall_px" type="box" pos="0.32 0 0.02" size="0.01 0.32 0.03" rgba="0.4 0.4 0.5 1"/>
    <geom name="wall_nx" type="box" pos="-0.32 0 0.02" size="0.01 0.32 0.03" rgba="0.4 0.4 0.5 1"/>
    <geom name="wall_py" type="box" pos="0 0.32 0.02" size="0.32 0.01 0.03" rgba="0.4 0.4 0.5 1"/>
    <geom name="wall_ny" type="box" pos="0 -0.32 0.02" size="0.32 0.01 0.03" rgba="0.4 0.4 0.5 1"/>

    <body name="pusher" pos="0 0 0.03">
      <joint name="px" type="slide" axis="1 0 0" range="-0.3 0.3" damping="8"/>
      <joint name="py" type="slide" axis="0 1 0" range="-0.3 0.3" damping="8"/>
      <geom name="pusher" type="cylinder" size="0.025 0.03" rgba="0.9 0.3 0.3 1"/>
    </body>

    <body name="ball" pos="0.1 0.1 0.03">
      <joint name="ball_free" type="free"/>
      <geom name="ball" type="sphere" size="0.03" rgba="0.3 0.55 0.95 1" mass="0.05" friction="0.6 0.01 0.001"/>
    </body>
  </worldbody>
  <actuator>
    <position joint="px" kp="60" ctrlrange="-0.3 0.3"/>
    <position joint="py" kp="60" ctrlrange="-0.3 0.3"/>
  </actuator>
</mujoco>
